# Copy to .env for local use. Never commit .env.
POSTGRES_DB=ies
POSTGRES_USER=ies_app
POSTGRES_PASSWORD=change-me-locally
REDIS_PASSWORD=change-me-locally-too
DATABASE_URL=jdbc:postgresql://localhost:5432/ies
DATABASE_USERNAME=ies_app
DATABASE_PASSWORD=change-me-locally

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

IES_STORAGE_ROOT=./data/invoices
IES_AI_WORKER_URL=http://localhost:8090
IES_AI_DEMO_FALLBACK=true
IES_ALLOWED_ORIGINS=http://localhost:5173
IES_AUTH_ENABLED=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
IES_MAPPING_PROVIDER=ollama
IES_MIN_FIELD_CONFIDENCE=0.70
IES_MAX_FILE_BYTES=20971520
IES_MAX_PAGES=20
PADDLEOCR_LANG=en

# Production identity example (do not store tenant/client secrets here)
JWT_ISSUER_URI=
JWT_AUDIENCE=ies-api
