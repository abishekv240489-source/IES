# Copy to .env for local use. Never commit .env.
POSTGRES_DB=ies
POSTGRES_USER=ies_app
POSTGRES_PASSWORD=change-me-locally
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ies
DATABASE_USERNAME=ies_app
DATABASE_PASSWORD=change-me-locally

IES_STORAGE_ROOT=./data/invoices
IES_AI_WORKER_URL=http://localhost:8090
IES_AI_DEMO_FALLBACK=true
IES_ALLOWED_ORIGINS=http://localhost:5173
IES_AUTH_ENABLED=false
IES_PROCESSOR_CONCURRENCY=4
IES_PROCESSOR_POLL_MS=500
IES_AI_TIMEOUT_MS=45000

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
IES_MAPPING_PROVIDER=ollama
IES_MIN_FIELD_CONFIDENCE=0.70
IES_MAX_FILE_BYTES=20971520
IES_MAX_PAGES=20
PADDLEOCR_LANG=en
PADDLEOCR_ENABLE_MKLDNN=true
PADDLE_PDX_CACHE_HOME=./models/paddlex
PADDLEOCR_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLEOCR_RECOGNITION_MODEL=en_PP-OCRv5_mobile_rec
PADDLEOCR_RECOGNITION_BATCH_SIZE=16
PADDLEOCR_DETECTION_LIMIT_SIDE=1280
PADDLEOCR_DETECTION_LIMIT_TYPE=max
PADDLEOCR_USE_ORIENTATION=false
PADDLEOCR_USE_UNWARPING=false
PADDLEOCR_USE_TEXTLINE_ORIENTATION=false

# Production identity example (do not store tenant/client secrets here)
JWT_ISSUER_URI=
JWT_AUDIENCE=ies-api
